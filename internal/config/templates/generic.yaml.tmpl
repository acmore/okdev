---
name: generic
description: "Bring your own manifest: set --manifest-path and --inject-path"
stignorePreset: default
---
apiVersion: okdev.io/v1alpha1
kind: DevEnvironment
metadata:
  name: {{ .Name }}
spec:
  namespace: {{ .Namespace }}
{{- if .KubeContext }}
  kubeContext: {{ .KubeContext }}
{{- end }}
  session:
    defaultNameTemplate: '{{`{{ .Repo }}-{{ .User }}`}}'
  sync:
    engine: syncthing
    syncthing:
      version: {{ .SyncthingVersion }}
      autoInstall: true
    paths:
      - "{{ .SyncLocal }}:{{ .SyncRemote }}"
  ports:
    - name: app
      local: 8080
      remote: 8080
  workload:
    type: generic
    manifestPath: {{ .ManifestPath }}
    inject:
{{- range .InjectPaths }}
      - path: "{{ . }}"
{{- end }}
{{- if .AttachContainer }}
    attach:
      container: {{ .AttachContainer }}
{{- end }}
  ssh:
    user: {{ .SSHUser }}
{{- if .Shell }}
    shell: {{ .Shell }}
{{- end }}
    keepAliveIntervalSeconds: 30
    keepAliveTimeoutSeconds: 90
  sidecar:
{{- if .SidecarImage }}
    image: {{ .SidecarImage }}
{{- end }}
    resources:
      requests:
        cpu: "{{ .SidecarCPU }}"
        memory: {{ .SidecarMemory }}
      limits:
        cpu: "{{ .SidecarCPU }}"
        memory: {{ .SidecarMemory }}
